# Binary files
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with go test -c
*.test

# Output of the go coverage tool
*.out

# Environment variables
.env

# GoReleaser output — `goreleaser release --snapshot --clean` writes every
# cross-compiled binary here. Committing them to a public repo is permanent.
dist/

# Go workspace files, which are local-machine state
go.work
go.work.sum

# macOS
.DS_Store
