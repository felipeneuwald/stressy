# Tool versions used by CI and the release pipeline — the canonical manifest.
# Bump a version here and every consumer picks it up on the next run:
#   - .github/actions/load-versions/action.yml (sourced; exposes each as an output)
#   - .github/workflows/ci.yml
#   - .github/workflows/goreleaser.yml
#
# Keep the format simple `KEY=value` so bash can source it directly. Quote any
# value containing spaces or shell metacharacters.
#
# Every tool CI installs is declared here, including the ones that float. A
# floating selector ('stable', 'latest', '~> v2') is still a version decision,
# and recording it makes the policy reviewable — and gives anyone who needs to
# pin a tool in a hurry exactly one file to edit.

# Passed to actions/setup-go. 'stable' resolves to the newest Go release, so a
# toolchain security fix reaches release binaries without anyone editing a
# file — the silent decay issue #13 documents. Note setup-go v6+ sets
# GOTOOLCHAIN=local, so this must always satisfy go.mod's `go` directive.
GO_VERSION=stable

# Pinned, unlike govulncheck below: golangci-lint decides whether the build is
# red, so a new release must not fail CI on a commit that did not touch the
# code.
GOLANGCI_LINT_VERSION=2.12.2

# SHA-256 of the linux-amd64 tarball for the version above — the two are bumped
# together, and a bump that moves one without the other fails the lint job at
# the `sha256sum -c` in ci.yml rather than installing something unverified.
# Source: the golangci-lint-<version>-checksums.txt asset on that release.
GOLANGCI_LINT_SHA256=8df580d2670fed8fa984aac0507099af8df275e665215f5c7a2ae3943893a553

# Module query appended to `go run golang.org/x/vuln/cmd/govulncheck@...`.
# Floats on purpose: the CVE corpus is fetched from vuln.go.dev at scan time,
# so staying current with scanner features is the right default. Set an exact
# version here if a govulncheck release ever breaks CI.
GOVULNCHECK_VERSION=latest

# Float within v2 — goreleaser-action's own default. A hard pin here has no
# updater: dependabot's github-actions ecosystem bumps `uses:` refs but never
# an input value, so an exact version would move only when someone remembered.
GORELEASER_VERSION='~> v2'
